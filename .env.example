# Pi Autopilot Environment Variables
# Copy this file to .env and configure the values below
#
# Usage:
#   1. cp .env.example .env
#   2. Edit .env with your values
#   3. export $(cat .env | xargs)
#   4. ./pi-autopilot run -config config.yaml
#
# Required:
#   PI_AUTOPILOT_TELEGRAM_TOKEN: Your BotFather token
#   PI_AUTOPILOT_AUTHORIZED_USER_ID: Your Telegram user ID (must match the user who will control the bot)

# Telegram Configuration
PI_AUTOPILOT_TELEGRAM_TOKEN=your_bot_token_here
PI_AUTOPILOT_TELEGRAM_CHAT_ID=
PI_AUTOPILOT_AUTHORIZED_USER_ID=123456789  # Your Telegram user ID from @get_my_id_bot

# ========== CONFIG.YAML VARIABLES ==========
# Format: PI_AUTOPILOT_<KEY_FROM_YAML>
# Key naming: Replace '.' with '_' and use UPPERCASE

# Repository to manage
PI_AUTOPILOT_REPO=
PI_AUTOPILOT_MILESTONE=
PI_AUTOPILOT_LABEL=
PI_AUTOPILOT_STATE_DIR=
PI_AUTOPILOT_POLL_SECONDS=
PI_AUTOPILOT_IDLE_TIMEOUT_MINUTES=
PI_AUTOPILOT_STAGE_TIMEOUT_MINUTES=
PI_AUTOPILOT_MAX_STAGE_RETRIES=
PI_AUTOPILOT_MAX_REVIEW_ROUNDS=
PI_AUTOPILOT_MAX_CI_FIXES=
PI_AUTOPILOT_MAX_LOCAL_FIXES=
PI_AUTOPILOT_CI_WAIT_MINUTES=
PI_AUTOPILOT_AUTO_MERGE=false
PI_AUTOPILOT_CHECK_COMMAND=
PI_AUTOPILOT_MANUAL_REPO=
PI_AUTOPILOT_MANUAL_MILESTONE=

# ========== MODEL CONFIGURATION ==========
PI_AUTOPILOT_INVESTIGATE_PROVIDER=omlx
PI_AUTOPILOT_INVESTIGATE_ID=Qwen3.5-9B-MLX-8bit
PI_AUTOPILOT_INVESTIGATE_THINKING=low
PI_AUTOPILOT_PLAN_PROVIDER=omlx
PI_AUTOPILOT_PLAN_ID=Qwen3.8-27B-4bit
PI_AUTOPILOT_PLAN_THINKING=medium
PI_AUTOPILOT_IMPLEMENT_PROVIDER=omlx
PI_AUTOPILOT_IMPLEMENT_ID=Qwen3-Coder-Next-MLX-4bit
PI_AUTOPILOT_IMPLEMENT_THINKING=off
PI_AUTOPILOT_REVIEW_PROVIDER=omlx
PI_AUTOPILOT_REVIEW_ID=GLM-4.7-Flash-MLX-8bit
PI_AUTOPILOT_REVIEW_THINKING=low
PI_AUTOPILOT_CHAT_PROVIDER=omlx
PI_AUTOPILOT_CHAT_ID=GLM-4.7-Flash-MLX-8bit
PI_AUTOPILOT_CHAT_THINKING=low
PI_AUTOPILOT_ALLOWED_MODELS=Qwen3.5-9B-MLX-8bit, Qwen3.8-27B-4bit, Qwen3-Coder-Next-MLX-4bit, GLM-4.7-Flash-MLX-8bit, MiMo-V2.6-Distill-Qwen-9B-MLX-4bit

OPENAI_API_KEY=optional_sk_key
ANTHROPIC_API_KEY=optional_sk_key
