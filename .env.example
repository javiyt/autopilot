# Pi Autopilot Environment Variables
# Copy this file to .env and configure the values below
#
# Usage:
#   1. cp .env.example .env
#   2. Edit .env with your values
#   3. export $(cat .env | xargs)
#   4. ./pi-autopilot run -config config.yaml
#
# Required:
#   PI_AUTOPILOT_TELEGRAM_TOKEN: Your BotFather token

# Telegram Configuration
PI_AUTOPILOT_TELEGRAM_TOKEN=your_bot_token_here
PI_AUTOPILOT_TELEGRAM_CHAT_ID=

# ========== CONFIG.YAML VARIABLES ==========
# Format: PI_AUTOPILOT_<KEY_FROM_YAML>
# Key naming: Replace '.' with '_' and use UPPERCASE
# Example: For "poll_seconds: 60" in YAML, use: PI_AUTOPILOT_POLL_SECONDS=60

# Repository to manage
#   YAML: repo: ${PI_AUTOPILOT_REPO:-default/repo}
PI_AUTOPILOT_REPO=

# Milestone identifier  
#   YAML: milestone: ${PI_AUTOPILOT_MILESTONE:-}
PI_AUTOPILOT_MILESTONE=

# Label to trigger autopilot
#   YAML: label: ${PI_AUTOPILOT_LABEL:-agent-ready}
PI_AUTOPILOT_LABEL=

# State directory (relative to config.yaml)
#   YAML: state_dir: ${PI_AUTOPILOT_STATE_DIR:-./autopilot-state}
PI_AUTOPILOT_STATE_DIR=

# Polling interval in seconds
#   YAML: poll_seconds: ${PI_AUTOPILOT_POLL_SECONDS:-60}
PI_AUTOPILOT_POLL_SECONDS=

# Idle timeout in minutes
#   YAML: idle_timeout_minutes: ${PI_AUTOPILOT_IDLE_TIMEOUT_MINUTES:-20}
PI_AUTOPILOT_IDLE_TIMEOUT_MINUTES=

# Stage timeout in minutes
#   YAML: stage_timeout_minutes: ${PI_AUTOPILOT_STAGE_TIMEOUT_MINUTES:-180}
PI_AUTOPILOT_STAGE_TIMEOUT_MINUTES=

# Maximum retries per stage
#   YAML: max_stage_retries: ${PI_AUTOPILOT_MAX_STAGE_RETRIES:-3}
PI_AUTOPILOT_MAX_STAGE_RETRIES=

# Maximum review rounds
#   YAML: max_review_rounds: ${PI_AUTOPILOT_MAX_REVIEW_ROUNDS:-3}
PI_AUTOPILOT_MAX_REVIEW_ROUNDS=

# Maximum CI fixes
#   YAML: max_ci_fixes: ${PI_AUTOPILOT_MAX_CI_FIXES:-2}
PI_AUTOPILOT_MAX_CI_FIXES=

# Maximum local fixes
#   YAML: max_local_fixes: ${PI_AUTOPILOT_MAX_LOCAL_FIXES:-3}
PI_AUTOPILOT_MAX_LOCAL_FIXES=

# CI wait time in minutes
#   YAML: ci_wait_minutes: ${PI_AUTOPILOT_CI_WAIT_MINUTES:-30}
PI_AUTOPILOT_CI_WAIT_MINUTES=

# Auto merge flag (true/false)
#   YAML: auto_merge: ${PI_AUTOPILOT_AUTO_MERGE:-false}
PI_AUTOPILOT_AUTO_MERGE=false

# Check command
#   YAML: check_commands:
#     - ${PI_AUTOPILOT_CHECK_COMMAND:-make check}
PI_AUTOPILOT_CHECK_COMMAND=

# Manual mode repo/milestone
#   YAML: manual_repo: ${PI_AUTOPILOT_MANUAL_REPO:-}
PI_AUTOPILOT_MANUAL_REPO=
#   YAML: manual_milestone: ${PI_AUTOPILOT_MANUAL_MILESTONE:-}
PI_AUTOPILOT_MANUAL_MILESTONE=

# ========== MODEL CONFIGURATION ==========
# Keys are exact model IDs from "pi --list-models" or "ollama --list"
# Example: For model "Qwen/Qwen2.5-7B-Instruct", use:
#   PI_AUTOPILOT_QWEN_QWEN2_5_7B_INSTRUCT_ID=Qwen/Qwen2.5-7B-Instruct

# Models (set exact IDs returned by your provider)
PI_AUTOPILOT_INVESTIGATE_PROVIDER=omlx
PI_AUTOPILOT_INVESTIGATE_ID=Qwen3.5-9B-MLX-8bit
PI_AUTOPILOT_INVESTIGATE_THINKING=low

PI_AUTOPILOT_PLAN_PROVIDER=omlx
PI_AUTOPILOT_PLAN_ID=Qwen3.8-27B-4bit
PI_AUTOPILOT_PLAN_THINKING=medium

PI_AUTOPILOT_IMPLEMENT_PROVIDER=omlx
PI_AUTOPILOT_IMPLEMENT_ID=Qwen3-Coder-Next-MLX-4bit
PI_AUTOPILOT_IMPLEMENT_THINKING=off

PI_AUTOPILOT_REVIEW_PROVIDER=omlx
PI_AUTOPILOT_REVIEW_ID=GLM-4.7-Flash-MLX-8bit
PI_AUTOPILOT_REVIEW_THINKING=low

PI_AUTOPILOT_CHAT_PROVIDER=omlx
PI_AUTOPILOT_CHAT_ID=GLM-4.7-Flash-MLX-8bit
PI_AUTOPILOT_CHAT_THINKING=low

# Allowed models (comma-separated, model IDs only)
PI_AUTOPILOT_ALLOWED_MODELS=Qwen3.5-9B-MLX-8bit, Qwen3.8-27B-4bit, Qwen3-Coder-Next-MLX-4bit, GLM-4.7-Flash-MLX-8bit, MiMo-V2.6-Distill-Qwen-9B-MLX-4bit

# ========== EXTERNAL PROVIDERS ==========
# For OpenAI, Anthropic, or custom endpoints
# Set these in the models section of config.yaml:
#   id: ${PI_AUTOPILOT_OPENAI_IMPLEMENT_ID:-gpt-4o}
#   base_url: ${PI_AUTOPILOT_OPENAI_BASE_URL:-https://api.openai.com/v1}
#   api_key: ${PI_AUTOPILOT_OPENAI_API_KEY:-}

OPENAI_API_KEY=optional_sk_key
ANTHROPIC_API_KEY=optional_sk_key
